{
	"name": "full-block-embed",
	"version": "1.0.3",
	"description": "Embed the full Markdown of a source block in other notes and keep every copy syncronized in Obsidian (https://obsidian.md)",
	"author": "garbsclassic",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node --env-file-if-exists=.env esbuild.config.mjs production",
		"check": "npm run lint && npm run test",
		"dev": "node --env-file-if-exists=.env esbuild.config.mjs",
		"lint": "eslint .",
		"tag": "node tag.mjs",
		"test": "node --test tests/*.test.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@types/node": "^26.6.6",
		"esbuild": "0.28.2",
		"eslint": "^10.15.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.59.1"
	}
}
